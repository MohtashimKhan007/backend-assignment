{
  "info": {
    "name": "GitHub Repository Searcher API",
    "description": "Postman Collection for GitHub Repository Searcher & Manager API deployed on Render",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://github-repo-searcher-jqa5.onrender.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Search Repositories & Upsert to DB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"spring boot\",\n  \"language\": \"Java\",\n  \"sort\": \"stars\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/github/search",
          "host": ["{{baseUrl}}"],
          "path": ["api", "github", "search"]
        }
      }
    },
    {
      "name": "2. Get Saved Repositories (Filter by Language, MinStars & Sort by Stars)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/github/repositories?language=Java&minStars=100&sort=stars",
          "host": ["{{baseUrl}}"],
          "path": ["api", "github", "repositories"],
          "query": [
            {
              "key": "language",
              "value": "Java"
            },
            {
              "key": "minStars",
              "value": "100"
            },
            {
              "key": "sort",
              "value": "stars"
            }
          ]
        }
      }
    },
    {
      "name": "3. Get Saved Repositories (Sort by Forks)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/github/repositories?sort=forks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "github", "repositories"],
          "query": [
            {
              "key": "sort",
              "value": "forks"
            }
          ]
        }
      }
    },
    {
      "name": "4. Get Saved Repositories (Sort by Updated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/github/repositories?sort=updated",
          "host": ["{{baseUrl}}"],
          "path": ["api", "github", "repositories"],
          "query": [
            {
              "key": "sort",
              "value": "updated"
            }
          ]
        }
      }
    },
    {
      "name": "5. Validation Test - Empty Query (Should return 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"\",\n  \"language\": \"Java\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/github/search",
          "host": ["{{baseUrl}}"],
          "path": ["api", "github", "search"]
        }
      }
    }
  ]
}
